
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  draft
  unpaid
  partially_paid
  paid
  cancelled
}

enum PaymentMethod {
  cash
  upi
  bank_transfer
  card
  other
}

enum PaymentKind {
  advance
  partial
  final
}

enum PaymentVerificationStatus {
  seller_recorded
}

enum FollowUpStatus {
  draft
  sent
}

enum FollowUpChannel {
  whatsapp
  copied
  other
}

enum ExpenseCategory {
  blank_t_shirts
  printing
  yarn
  packaging
  delivery
  other
}

enum ExpenseStatus {
  unpaid
  paid
}

enum AlertType {
  overdue_invoice
  upcoming_bill
  cash_shortage
  overdue_no_expected_date
}

enum AlertStatus {
  active
  resolved
}

enum ScenarioStatus {
  active
  reset
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  email               String    @unique
  name                String
  clerkUserId         String    @unique @map("clerk_user_id")
  isDemo              Boolean   @default(false) @map("is_demo")
  lastSignedInAt      DateTime? @map("last_signed_in_at")
  lastSignedOutAt     DateTime? @map("last_signed_out_at")
  deletedAt           DateTime? @map("deleted_at")

  shop Shop?

  tokenVersion Int @default(0)
  @@map("users")
}

model Shop {
  id                            String    @id @default(uuid()) @db.Uuid
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")
  userId                        String    @unique @map("user_id") @db.Uuid
  name                          String
  phone                         String?
  email                         String?
  address                       String?   @db.Text
  openingCashBalance            Decimal?  @map("opening_cash_balance") @db.Decimal(12, 2)
  openingBalanceEffectiveDate   DateTime? @map("opening_balance_effective_date") @db.Date

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers Customer[]
  savedItems SavedItem[]
  invoices  Invoice[]
  expenses  Expens[]
  alerts    Alert[]
  scenarios Scenario[]

  @@map("shops")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shopId    String   @map("shop_id") @db.Uuid
  name      String
  phone     String?
  email     String?

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([shopId])
  @@map("customers")
}

model SavedItem {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  shopId      String   @map("shop_id") @db.Uuid
  description String
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("saved_items")
}

model Invoice {
  id                     String        @id @default(uuid()) @db.Uuid
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  shopId                 String        @map("shop_id") @db.Uuid
  customerId             String        @map("customer_id") @db.Uuid
  invoiceNumber          String        @map("invoice_number")
  status                 InvoiceStatus @default(draft)
  issueDate              DateTime      @map("issue_date") @db.Date
  dueDate                DateTime      @map("due_date") @db.Date
  expectedCollectionDate DateTime?     @map("expected_collection_date") @db.Date
  totalAmount            Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes                  String?       @db.Text

  shop      Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer  Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items     InvoiceItem[]
  payments  Payment[]
  followUps FollowUp[]
  alerts    Alert[]
  scenarios Scenario[]

  @@index([shopId, status, dueDate])
  @@unique([shopId, invoiceNumber])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id                 String                     @id @default(uuid()) @db.Uuid
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  invoiceId          String                     @map("invoice_id") @db.Uuid
  amount             Decimal                    @db.Decimal(12, 2)
  paidOn             DateTime                   @map("paid_on") @db.Date
  method             PaymentMethod
  kind               PaymentKind
  verificationStatus PaymentVerificationStatus  @default(seller_recorded) @map("verification_status")
  idempotencyKey     String                     @map("idempotency_key")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@unique([invoiceId, idempotencyKey])
  @@map("payments")
}

model FollowUp {
  id        String          @id @default(uuid()) @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  invoiceId String          @map("invoice_id") @db.Uuid
  body      String          @db.Text
  status    FollowUpStatus  @default(draft)
  channel   FollowUpChannel?
  sentAt    DateTime?       @map("sent_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("follow_ups")
}

model Expens {
  id                  String          @id @default(uuid()) @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  shopId              String          @map("shop_id") @db.Uuid
  description         String
  category            ExpenseCategory
  amount              Decimal         @db.Decimal(12, 2)
  dueDate             DateTime        @map("due_date") @db.Date
  status              ExpenseStatus   @default(unpaid)
  paidOn              DateTime?       @map("paid_on") @db.Date
  revisedPaymentDate  DateTime?       @map("revised_payment_date") @db.Date

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  alerts Alert[]

  @@index([shopId, status, dueDate])
  @@map("expenses")
}

model Alert {
  id              String      @id @default(uuid()) @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  shopId          String      @map("shop_id") @db.Uuid
  alertType       AlertType   @map("alert_type")
  status          AlertStatus @default(active)
  invoiceId       String?     @map("invoice_id") @db.Uuid
  expenseId       String?     @map("expense_id") @db.Uuid
  shortageDate    DateTime?   @map("shortage_date") @db.Date
  shortageAmount  Decimal?    @map("shortage_amount") @db.Decimal(12, 2)
  message         String      @db.Text
  actionTakenAt   DateTime?   @map("action_taken_at")
  resolvedAt      DateTime?   @map("resolved_at")

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  expense Expens?  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@index([invoiceId])
  @@index([expenseId])
  @@map("alerts")
}

model Scenario {
  id                               String         @id @default(uuid()) @db.Uuid
  createdAt                        DateTime       @default(now()) @map("created_at")
  updatedAt                        DateTime       @updatedAt @map("updated_at")
  shopId                           String         @map("shop_id") @db.Uuid
  invoiceId                        String         @map("invoice_id") @db.Uuid
  status                           ScenarioStatus @default(active)
  delayDays                        Int            @default(15) @map("delay_days")
  forecastDays                     Int            @default(30) @map("forecast_days")
  scenarioExpectedCollectionDate   DateTime?      @map("scenario_expected_collection_date") @db.Date
  baselineMinCash                  Decimal?       @map("baseline_min_cash") @db.Decimal(12, 2)
  scenarioMinCash                  Decimal?       @map("scenario_min_cash") @db.Decimal(12, 2)
  baselineFirstShortageDate        DateTime?      @map("baseline_first_shortage_date") @db.Date
  scenarioFirstShortageDate        DateTime?      @map("scenario_first_shortage_date") @db.Date
  shortageAmount                   Decimal?       @map("shortage_amount") @db.Decimal(12, 2)
  suggestedAction                  String?        @map("suggested_action") @db.Text
  isBaseline                       Boolean        @default(false) @map("is_baseline")

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@index([invoiceId])
  @@map("scenarios")
}

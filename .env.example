# Copy to .env; never commit your real values.
DATABASE_URL="postgresql://pocketdash:pocketdash_local@localhost:5432/pocketdash"
# Enable the isolated, fictional judge demo. Disable if not needed.
ENABLE_DEMO="true"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# Add both keys from your Clerk application to enable private sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
# Optional: configure /api/webhooks/clerk for user.updated and user.deleted.
CLERK_WEBHOOK_SIGNING_SECRET=""
